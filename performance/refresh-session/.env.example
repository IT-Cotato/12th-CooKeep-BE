# Local benchmark only. Do not reuse these values in any deployed environment.
BENCHMARK_DB_PASSWORD=change-me

# Must match the BCrypt fixture in mysql/seed.sql. The current fixture uses
# the isolated benchmark-only password shown below.
BENCHMARK_USER_PASSWORD=password1

# Use two different random strings of at least 32 bytes.
BENCHMARK_JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-bytes
BENCHMARK_JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-at-least-32-bytes

# Generate a benchmark-only VAPID key pair. Never copy production keys here.
BENCHMARK_VAPID_PUBLIC_KEY=
BENCHMARK_VAPID_PRIVATE_KEY=
